  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "recipeId",
      "value": ""
    },
    {
      "key": "mealPlanId",
      "value": ""
    },

    {
      "key": "anotherRecipeId",
      "value": ""
    },
    {
      "key": "groceryListId",
      "value": ""
    },
    {
      "key": "groceryItemId",
      "value": ""
    }
  ],
