    {
      "name": "Recipes",
      "item": [
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Chicken Rice Bowl\",\n  \"description\": \"A simple chicken rice bowl\",\n  \"image\": \"https://example.com/chicken-rice.jpg\",\n  \"prepTime\": 10,\n  \"cookTime\": 25,\n  \"servings\": 2,\n  \"instructions\": \"Cook the rice and chicken, then combine and serve.\",\n  \"category\": \"DINNER\",\n  \"ingredients\": [\n    {\n      \"name\": \"Chicken breast\",\n      \"quantity\": \"300g\"\n    },\n    {\n      \"name\": \"Rice\",\n      \"quantity\": \"200g\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recipes",
              "host": ["{{baseUrl}}"],
              "path": ["recipes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json()?.data;",
                  "if (data?.id) pm.collectionVariables.set('recipeId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes/my",
              "host": ["{{baseUrl}}"],
              "path": ["recipes", "my"]
            }
          }
        },
        {
          "name": "Get Recipe By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recipes/{{recipeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["recipes", "{{recipeId}}"]
            }
          }
        }
      ]
    },
    {
